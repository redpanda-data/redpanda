            "type": "string"
        },
        "port": {
            "type": "int"
        },
        "tls_enabled": {
            "type": "boolean"
        },
        "mutual_tls_enabled": {
            "type": "boolean"
        },
        "authentication_methods": {
            "type": "array",
            "items": {
                "type": "string",
                "enum": [
                    "BASIC",
